# Copy to .env and adjust as needed. All values are also configurable
# through plain environment variables.

# The sensor stream normally runs manually on the host (see README). Set the rate with:
#   RATE=200 python scripts/stream.py
#
# Alternatively run the generator as a Docker Compose service (self-contained,
# no manual host process):
#   SENSOR_WS_URL=ws://sensor:8765 docker compose --profile sensor up -d --build
#   SENSOR_RATE=200                    # generator rate inside the container

# Optional: override backend tuning
# WORKER_BATCH_SIZE=200
# WORKER_BLOCK_MS=500
# PENDING_CLAIM_IDLE_MS=30000
# PENDING_CLAIM_INTERVAL=10
# HEARTBEAT_EXPECTED_INTERVAL=10
# HEARTBEAT_OFFLINE_TIMEOUT=30
# HEARTBEAT_SCAN_INTERVAL=5
# STREAM_MAXLEN=1000000

# Optional: correlation / pattern-detection tuning
# CORRELATION_SCAN_INTERVAL=5
# CORRELATION_WINDOW=60
# CORRELATION_REPEAT_THRESHOLD=3
# CORRELATION_MULTI_SIGNAL_THRESHOLD=3
# CORRELATION_BURST_THRESHOLD=3